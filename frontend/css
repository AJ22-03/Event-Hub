/* =============================================================================
   EventHub — events.css (Events Catalog, Filters & Leaflet Map Styles)
   ============================================================================= */

.events-header {
  padding: 50px 5% 30px;
  background: rgba(26, 26, 26, 0.4);
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
}

.events-header h1 {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem;
  margin-bottom: 8px;
}

.events-layout {
  display: grid;
  grid-template-columns: 290px 1fr;
