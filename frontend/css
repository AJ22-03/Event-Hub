  transform: translateY(-4px);
}

.quiz-cat-card i {
  font-size: 2rem;
  color: var(--gold-light);
  margin-bottom: 12px;
}

/* Active Quiz Question Header */
.quiz-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid rgba(212, 175, 55, 0.2);
  padding-bottom: 16px;
  margin-bottom: 24px;
}

.question-counter {
  font-size: 0.9rem;
  color: var(--muted-gold);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.quiz-timer {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--gold-light);
  background: rgba(26, 26, 26, 0.8);
  padding: 6px 14px;
  border-radius: 20px;
  border: 1px solid rgba(212, 175, 55, 0.4);
}

.question-text {
  font-family: 'Playfair Display', serif;
  font-size: 1.45rem;
  color: var(--cream);
  line-height: 1.4;
  margin-bottom: 28px;
}

/* Options Layout */
.quiz-options-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 28px;
}

.quiz-option-btn {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 22px;
  background: rgba(26, 26, 26, 0.65);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: var(--radius);
  color: var(--ivory);
  font-size: 1rem;
  cursor: pointer;
  transition: all var(--transition);
  text-align: left;
  width: 100%;
}

.option-badge {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(212, 175, 55, 0.15);
  color: var(--gold-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.9rem;
  flex-shrink: 0;
  border: 1px solid rgba(212, 175, 55, 0.35);
}

.quiz-option-btn:hover {
  border-color: var(--gold);
  background: rgba(212, 175, 55, 0.12);
}

.quiz-option-btn.selected {
  border-color: var(--gold);
  background: rgba(212, 175, 55, 0.2);
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.25);
}

/* Feedback States */
.quiz-option-btn.correct {
  border-color: var(--success);
  background: rgba(16, 185, 129, 0.2) !important;
  color: #a7f3d0;
}

.quiz-option-btn.correct .option-badge {
  background: var(--success);
  color: #064e3b;
}

.quiz-option-btn.incorrect {
  border-color: var(--error);
  background: rgba(239, 68, 68, 0.2) !important;
  color: #fca5a5;
}

.quiz-option-btn.incorrect .option-badge {
  background: var(--error);
  color: #fff;
}

.feedback-banner {
  padding: 16px 20px;
  border-radius: var(--radius-sm);
  margin-bottom: 24px;
  display: none;
  font-size: 0.95rem;
}

.feedback-banner.correct {
  background: rgba(16, 185, 129, 0.18);
  border: 1px solid var(--success);
  color: #a7f3d0;
  display: block;
}

.feedback-banner.incorrect {
  background: rgba(239, 68, 68, 0.18);
  border: 1px solid var(--error);
  color: #fca5a5;
  display: block;
}

/* Results Screen */
.results-card {
  text-align: center;
  padding: 20px;
}

.score-circle {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  border: 4px solid var(--gold);
  margin: 20px auto 30px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(36, 5, 14, 0.6);
  box-shadow: 0 0 30px rgba(212, 175, 55, 0.4);
}

.score-number {
  font-family: 'Playfair Display', serif;
  font-size: 2.8rem;
  font-weight: 800;
  color: var(--gold-light);
  line-height: 1;
}

.score-pct {
  font-size: 0.9rem;
  color: var(--muted-gold);
}
