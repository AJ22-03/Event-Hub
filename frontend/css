/* Feature Spotlight Banners */
.spotlight-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  margin: 60px 0;
}

.spotlight-card {
  padding: 35px;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(212, 175, 55, 0.3);
  background: rgba(36, 5, 14, 0.5);
  backdrop-filter: blur(16px);
  position: relative;
  overflow: hidden;
}

@media (max-width: 900px) {
  .hero-visual-stage { display: none; }
  .spotlight-grid { grid-template-columns: 1fr; }
}
/* =============================================================================
   EventHub — quiz.css (Live Event Quiz & Trivia Arena Styles - Matching SRS)
