}
/* =============================================================================
   EventHub — home.css (Landing & Index Page Styles)
   ============================================================================= */

/* Ambient Glowing Background Orbs */
.bg-glow-orb {
  position: fixed;
  border-radius: 50%;
  filter: blur(140px);
  z-index: 0;
  opacity: 0.4;
  pointer-events: none;
  animation: floatOrb 12s infinite ease-in-out alternate;
}

.orb-maroon {
  width: 600px;
  height: 600px;
  top: -8%;
  left: -6%;
  background: #3B0918;
}

.orb-gold {
  width: 500px;
  height: 500px;
  bottom: 6%;
  right: -6%;
  background: radial-gradient(circle, rgba(212,175,55,0.45), rgba(183,110,121,0.25));
  animation-delay: -6s;
}

@keyframes floatOrb {
  0% { transform: translate(0, 0) scale(1); }
  100% { transform: translate(50px, 35px) scale(1.12); }
}

/* Hero Section */
.hero-section {
  position: relative;
  min-height: 85vh;
  display: flex;
  align-items: center;
  padding: 60px 5%;
  overflow: hidden;
}

.hero-content {
  max-width: 650px;
  position: relative;
  z-index: 5;
}

.hero-badge-gold {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(59, 9, 24, 0.7);
  border: 1px solid rgba(212, 175, 55, 0.45);
  padding: 8px 20px;
  border-radius: 30px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--gold-light);
  margin-bottom: 22px;
  box-shadow: 0 0 20px rgba(212, 175, 55, 0.25);
  backdrop-filter: blur(12px);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.4rem, 5vw, 4.2rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 20px;
  color: var(--cream);
}

.hero-title .gold-accent {
  background: linear-gradient(135deg, #D4AF37 0%, #F5D77F 50%, #B76E79 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-subtitle {
  font-size: 1.1rem;
  color: var(--text-secondary);
  margin-bottom: 35px;
  line-height: 1.7;
}

/* Hero Interactive Search Bar */
.hero-search-lux {
  display: flex;
  gap: 0;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(212, 175, 55, 0.45);
  background: rgba(36, 5, 14, 0.6);
  backdrop-filter: blur(20px);
  max-width: 650px;
  box-shadow: 0 20px 45px rgba(0,0,0,0.6), 0 0 30px rgba(212, 175, 55, 0.25);
  transition: all var(--transition);
}

.hero-search-lux:focus-within {
  border-color: var(--gold-light);
  box-shadow: 0 25px 55px rgba(0,0,0,0.7), 0 0 40px rgba(212, 175, 55, 0.45);
}

.hero-search-lux input, .hero-search-lux select {
  flex: 1;
  padding: 16px 20px;
  background: transparent;
  border: none;
  color: var(--cream);
  font-size: 0.95rem;
}

.hero-search-lux input:focus, .hero-search-lux select:focus {
  outline: none;
}

.hero-search-lux select {
  border-left: 1px solid rgba(212, 175, 55, 0.25);
  border-right: 1px solid rgba(212, 175, 55, 0.25);
  flex: 0.55;
  background: #1f0810;
}

.hero-search-lux button {
  padding: 16px 30px;
  background: var(--gradient);
  border: none;
  color: #160309;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.08em;
  display: flex;
  align-items: center;
  gap: 8px;
}

.hero-search-lux button:hover {
  background: var(--gradient-hover);
}

/* 3D Visual Stage */
.hero-visual-stage {
  position: absolute;
  right: 5%;
  top: 50%;
  transform: translateY(-50%);
  width: 45%;
  height: 480px;
  display: flex;
  align-items: center;
  justify-content: center;
  perspective: 1000px;
}

.hero-3d-card-stack {
  position: relative;
  width: 340px;
  height: 420px;
}

.hero-floating-card {
  position: absolute;
  inset: 0;
  border-radius: var(--radius-lg);
  padding: 24px;
  background: rgba(45, 8, 20, 0.7);
  border: 1px solid rgba(212, 175, 55, 0.4);
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.8), 0 0 35px rgba(212, 175, 55, 0.3);
  backdrop-filter: blur(16px);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transform: rotateY(-12deg) rotateX(10deg);
  animation: floatCard 6s ease-in-out infinite alternate;
}

@keyframes floatCard {
  0% { transform: translateY(0) rotateY(-12deg) rotateX(10deg); }
  100% { transform: translateY(-20px) rotateY(-8deg) rotateX(6deg); }
}

/* Section Header */
.section-header {
  text-align: center;
  margin-bottom: 50px;
  position: relative;
}

.section-subtitle {
  font-size: 0.85rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 10px;
  font-weight: 600;
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2rem, 3.5vw, 2.8rem);
  font-weight: 700;
  color: var(--cream);
}

/* Featured Event Card */
.event-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.event-card-header {
  height: 160px;
  background: linear-gradient(135deg, #3B0918, #1A1A1A);
  position: relative;
  padding: 16px;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
}

.event-card-body {
  padding: 24px;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.event-card-body h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.25rem;
  margin-bottom: 12px;
  color: var(--cream);
}

.event-meta {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.85rem;
  color: var(--muted-gold);
  margin-bottom: 6px;
}

.event-card-footer {
  padding: 16px 24px;
  border-top: 1px solid rgba(212, 175, 55, 0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* Categories Grid */
.category-card {
  padding: 30px 20px;
  text-align: center;
  cursor: pointer;
}

.category-icon {
  width: 65px;
  height: 65px;
  border-radius: 50%;
  margin: 0 auto 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  background: rgba(212, 175, 55, 0.12);
  color: var(--gold);
  border: 1px solid rgba(212, 175, 55, 0.35);
  transition: all var(--transition);
}

.category-card:hover .category-icon {
  background: var(--gradient);
  color: #1a080d;
  transform: scale(1.1) rotate(5deg);
